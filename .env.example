# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Comma-separated numeric Telegram user IDs authorized to control this Mac
TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional default Telegram group or DM chat ID for proactive announcements
TELEGRAM_CHAT_ID=

# Antigravity Desktop data directory (defaults to $HOME/.gemini/antigravity)
AGY_DATA_DIR=$HOME/.gemini/antigravity

# Local agentapi binary path (defaults to $HOME/.gemini/antigravity/bin/agentapi)
AGY_AGENTAPI_BIN=$HOME/.gemini/antigravity/bin/agentapi

# Default workspace directory used when /new starts a conversation without a path prefix
AGY_DEFAULT_WORKSPACE=/Volumes/Dev

# Optional default model passed to agentapi new-conversation (leave empty for Desktop default)
AGY_DEFAULT_MODEL=

# Flow-Gen-EN + No-AI-Slop composer mode: auto | always | off
AGY_FLOW_GEN_EN=auto

# Transcript polling interval in milliseconds (defaults to 650)
AGY_POLL_MS=650

# Persistent bindings and cursor state JSON file (defaults to ./.state/agy-tele-state.json)
AGY_STATE_PATH=.state/agy-tele-state.json
